/*
  aavantage.dlg

*!  VERSION 1.0.1  16jul2026

*/

VERSION 19.0

INCLUDE _std_large
DEFINE _dlght 460
INCLUDE header

HELP hlp1, view("help aavantage")
RESET res1

SCRIPT PREINIT
BEGIN
END

SCRIPT POSTINIT
BEGIN
END

DIALOG main, label("aavantage - import Alpha Vantage data")
BEGIN
  GROUPBOX gb_type			_lft	_top	_iwd	170,	///
  	label("Command")
  RADIO rb_set 				_ilft	_ss	_inwd	.,	///
	first 								///
	onclickon("program main_show_subcmd")				///
	label("Set API key")
  RADIO rb_search			@ 	_ss	@ 	.,	///
	onclickon("program main_show_subcmd")				///
	label("Search")
  RADIO rb_list				@ 	_ss	@ 	.,	///
  	onclickon("program main_show_subcmd") 				///
   	label("List")
  RADIO rb_stock			@ 	_ss	@ 	.,	///
	onclickon("program main_show_subcmd")				///
	label("Stock") 
  RADIO rb_index			@	_ss	@	.,	///
	onclickon("program main_show_subcmd")				///
	label("Index")
  RADIO rb_crypto			@	_ss	@	.,	///
	onclickon("program main_show_subcmd")				///
	label("Crypto")
  RADIO rb_commodity			@	_ss	@	.,	///
	last								///
	onclickon("program main_show_subcmd")				///
	label("Commodity")

// SET
  
  TEXT tx_key				_lft	+35	200	 .,	///
  	label("API key:")

  DEFINE holdy @y

  EDIT ed_key				@	_ss	@	 .,	///
	max(30)								///
	password							///
	tooltip("Enter the Alpha Vantage API key used by aavantage")	///
  	label("API key:")

   
  TEXT tx_search             _lft holdy _iwd ., ///
   	label("Search text:")

  EDIT ed_search             @ _ss @ ., ///
	tooltip("Enter a ticker symbol or company name") ///
	label("Search text:")


  TEXT tx_list               _lft holdy _iwd ., ///
   	 label("Category:")

  COMBOBOX cb_list           @ _ss 200 ., ///
	dropdownlist ///
	contents(list_labels) ///
	values(list_values) ///
	label("Category:")

// STOCK
   TEXT tx_stock_symbol			_lft	holdy	_iwd	.,	///
   	label("Ticker symbol:")
   EDIT ed_stock_symbol			@	_ss	 @	.,	///
	tooltip("Enter a stock ticker such as IBM, MSFT, or AAPL")	///
   	label("Ticker symbol:")
  
  GROUPBOX gb_options			_lft	_ls	_iwd	260,	///
  	label("Options")

  GROUPBOX gb_stock_time		_ilft	_ss	_inwd	80,	///
  	label("Frequency")
  RADIO rb_stock_daily			_iilft	_ss	100	.,	///
	first								///
	label("Daily")
  RADIO rb_stock_intraday		+110	@	@	.,	///
	onclickon("program main_stock_intraday_check")			///
	onclickoff("program main_stock_intraday_check")			///
	label("Intraday")
  RADIO rb_stock_weekly			+110	@	@	.,	///
	option(weekly)							///
	label("Weekly")
  RADIO rb_stock_monthly		+110	@	@	.,	///
	last								///
	option(monthly)							///
	label("Monthly")

  COMBOBOX cb_stock_interval		150	_ls	_spwd	.,	///
	dropdownlist							///
	contents(stock_intervals)					///
	default(5)							///
 	label("Minutes:")
  TEXT tx_stock_interval		_spsep	@	100	.,	///
 	 label("Minutes:")

  CHECKBOX ck_stock_adjusted		_ilft	+45	_cwd2 .,	///
	option(adjusted)						///
	label("Adjusted data")
  CHECKBOX ck_stock_full		@	_ms	@	.,	///
	option(full)							///
	label("Request full data from the server")
  CHECKBOX ck_stock_wide		_ilft2	-25	@	.,	///
	option(wide)							///
	label("Wide form")
  CHECKBOX ck_stock_clear		@	_ms	@	.,	///
	option(clear)							///
	label("Clear data in memory") ///


	// INDEX
  TEXT tx_index_symbol          _lft    holdy   _iwd    .,  ///
	label("Index symbol:")

  EDIT ed_index_symbol          @       _ss     @       .,  ///
	tooltip("Enter a market index symbol such as DJI")    ///
	label("Index symbol:")

  GROUPBOX gb_index_time        _ilft   +45     _inwd   50, ///
	label("Frequency")

  RADIO rb_index_daily          _iilft  _ss     100     .,  ///
	first                                                   ///
	label("Daily")

  RADIO rb_index_weekly         +110    @       @       .,  ///
	option(weekly)                                           ///
	label("Weekly")

  RADIO rb_index_monthly        +110    @       @       .,  ///
	last                                                    ///
	option(monthly)                                         ///
	label("Monthly")

  CHECKBOX ck_index_wide        _ilft   +45     _ibwd   .,  ///
	option(wide)                                            ///
	label("Wide form")

  CHECKBOX ck_index_clear       _ilft2      @     @       .,  ///
	option(clear)                                           ///
	label("Clear data in memory")


	/* Crypto controls */
  TEXT tx_crypto_symbol         _lft    holdy   _iwd    .,  ///
	label("Crypto symbol:")

  EDIT ed_crypto_symbol         @       _ss     @       .,  ///
	tooltip("Enter a cryptocurrency symbol such as BTC or ETH") ///
	label("Crypto symbol:")

  TEXT tx_crypto_market         _ilft    +45     100     .,  ///
	label("Market:")

  EDIT ed_crypto_market         @       _ss     100     .,  ///
	option(market)						///
	default("USD")                                           ///
	tooltip("Enter a market currency such as USD")           ///
	label("Market:")

  GROUPBOX gb_crypto_time       _ilft   _ls    460   80, ///
	label("Frequency")

  RADIO rb_crypto_daily         _iilft  _ss     100     .,  ///
	first                                                   ///
	label("Daily")

  RADIO rb_crypto_intraday      +110    @       @       .,  ///
	onclickon("program main_crypto_intraday_check")         ///
	onclickoff("program main_crypto_intraday_check")        ///
	label("Intraday")

  RADIO rb_crypto_weekly        +110    @       @       .,  ///
	option(weekly)                                           ///
	label("Weekly")

  RADIO rb_crypto_monthly       +110    @       @       .,  ///
	last                                                    ///
	option(monthly)                                         ///
	label("Monthly")

  COMBOBOX cb_crypto_interval   150     _ls     _spwd   .,  ///
	option(intraday)					///
	dropdownlist                                            ///
	contents(stock_intervals)                              ///
	default(5)                                             ///
	label("Minutes:")

  TEXT tx_crypto_interval       _spsep  @       100     .,  ///
	label("Minutes:")

  CHECKBOX ck_crypto_full       _ilft   +45     _cwd1   .,  ///
	option(full)                                            ///
	label("Request full data from the server")

  CHECKBOX ck_crypto_wide       _ilft2   @     @       .,  ///
	option(wide)                                            ///
	label("Wide form")

  CHECKBOX ck_crypto_clear      @       _ms    @       .,  ///
	option(clear)                                           ///
	label("Clear data in memory")

	/* Commodity controls */
  TEXT tx_commodity             _lft    holdy   _iwd    .,  ///
	label("Commodity:")

  COMBOBOX cb_commodity         @       _ss     200       .,  ///
	dropdownlist                                            ///
	contents(commodity_labels)                             ///
	values(commodity_values)                               ///
	tooltip("Select a supported commodity")                ///
	label("Commodity:")

  GROUPBOX gb_commodity_time    _ilft   +45     460   50, ///
	label("Frequency")

  RADIO rb_commodity_monthly    _iilft  _ss     80     .,  ///
	first                                                   ///
	label("Monthly")

  RADIO rb_commodity_daily      +85    @       @       .,  ///
	option(daily)                                            ///
	label("Daily")

  RADIO rb_commodity_weekly     +85    @       @       .,  ///
	option(weekly)                                           ///
	label("Weekly")

  RADIO rb_commodity_quarterly  +85  @     @     .,  ///
	option(quarterly)                                        ///
	label("Quarterly")

  RADIO rb_commodity_annual     +85    @       @       .,  ///
	last                                                     ///
	option(annual)                                           ///
	label("Annual")

  CHECKBOX ck_commodity_clear   _ilft   +45     _ibwd   .,  ///
	option(clear)                                             ///
	label("Clear data in memory")

END

LIST stock_intervals
BEGIN
	1
	5
	15
	30
	60
END

LIST list_labels
BEGIN
    "indexes"
    "cryptocurrency markets"
    "cryptocurrencies"
    "commodities"
END

LIST list_values
BEGIN
    index
    market
    crypto
    commodity
END

LIST commodity_labels
BEGIN
	"Gold and Silver spot"
	Gold
	Silver
	"WTI crude oil"
	"Brent crude oil"
	"Natural Gas"
	Copper
	aluminum
	wheat
	corn
	cotton
	sugar
	coffee
	"Global Price Index of all Commodities"
END

LIST commodity_values
BEGIN
	goldsilverspot
	gold
	silver
	oilwti
	oilbrent
	gas
	copper
	aluminum
	wheat
	corn
	cotton
	sugar
	coffee
	index
	
END


SCRIPT main_hide_all
BEGIN
	main.tx_key.hide
	main.ed_key.hide

	main.gb_options.hide

	main.tx_stock_symbol.hide
	main.ed_stock_symbol.hide

	main.gb_stock_time.hide
	main.rb_stock_daily.hide
	main.rb_stock_intraday.hide
	main.rb_stock_weekly.hide
	main.rb_stock_monthly.hide
	main.tx_stock_interval.hide
	main.cb_stock_interval.hide
	main.ck_stock_adjusted.hide
	main.ck_stock_full.hide
	main.ck_stock_wide.hide
	main.ck_stock_clear.hide

	main.tx_index_symbol.hide
	main.ed_index_symbol.hide
	main.gb_index_time.hide
	main.rb_index_daily.hide
	main.rb_index_weekly.hide
	main.rb_index_monthly.hide
	main.ck_index_wide.hide
	main.ck_index_clear.hide

	main.tx_crypto_symbol.hide
	main.ed_crypto_symbol.hide
	main.tx_crypto_market.hide
	main.ed_crypto_market.hide
	main.gb_crypto_time.hide
	main.rb_crypto_daily.hide
	main.rb_crypto_intraday.hide
	main.rb_crypto_weekly.hide
	main.rb_crypto_monthly.hide
	main.tx_crypto_interval.hide
	main.cb_crypto_interval.hide
	main.ck_crypto_full.hide
	main.ck_crypto_wide.hide
	main.ck_crypto_clear.hide

	main.tx_commodity.hide
	main.cb_commodity.hide
	main.gb_commodity_time.hide
	main.rb_commodity_monthly.hide
	main.rb_commodity_daily.hide
	main.rb_commodity_weekly.hide
	main.rb_commodity_quarterly.hide
	main.rb_commodity_annual.hide
	main.ck_commodity_clear.hide

	main.tx_search.hide
	main.ed_search.hide

	main.tx_list.hide
	main.cb_list.hide
END
	
PROGRAM main_show_subcmd
BEGIN
	call script main_hide_all
	if main.rb_set {
		call script main_show_set
	}
	if main.rb_stock {
		call script main_show_stock
	}
	if main.rb_index {	
    		call script main_show_index
	}
	if main.rb_crypto {
		call script main_show_crypto
	}
	if main.rb_commodity {
		call script main_show_commodity
	}
	if main.rb_search {
   		call script main_show_search
	}
	if main.rb_list {
		call script main_show_list
	}
END


SCRIPT main_show_set
BEGIN
	main.tx_key.show
	main.ed_key.show
END

SCRIPT main_show_search
BEGIN
    main.tx_search.show
    main.ed_search.show
END

SCRIPT main_show_list
BEGIN
    main.tx_list.show
    main.cb_list.show
END

SCRIPT main_show_stock
BEGIN
	main.gb_options.setposition . . . 170
	main.tx_stock_symbol.show
	main.ed_stock_symbol.show
	main.gb_options.show
	main.gb_stock_time.show
	main.gb_stock_time.show
	main.rb_stock_daily.show
	main.rb_stock_intraday.show
	main.rb_stock_weekly.show
	main.rb_stock_monthly.show
	main.tx_stock_interval.show
	main.ck_stock_adjusted.show
	main.ck_stock_full.show
	main.ck_stock_wide.show
	main.ck_stock_clear.show
	program main_stock_intraday_check
END


PROGRAM main_stock_intraday_check
BEGIN
	if main.rb_stock{
		call main.tx_stock_interval.show
		call main.cb_stock_interval.show
		if main.rb_stock_intraday {
			call main.tx_stock_interval.enable
			call main.cb_stock_interval.enable
			call main.ck_stock_full.enable
			call main.ck_stock_adjusted.disable
		}
		else {
			call main.tx_stock_interval.disable
			call main.cb_stock_interval.disable
			call main.ck_stock_full.disable
			call main.ck_stock_adjusted.enable
		}
		if main.rb_stock_daily {
			call main.ck_stock_full.enable
		}
	}
END

SCRIPT main_show_index
BEGIN
	main.gb_options.setposition . . . 105
	main.tx_index_symbol.show
	main.ed_index_symbol.show
	main.gb_options.show
	main.gb_index_time.show
	main.rb_index_daily.show
	main.rb_index_weekly.show
	main.rb_index_monthly.show
	main.ck_index_wide.show
	main.ck_index_clear.show
END

SCRIPT main_show_crypto
BEGIN
	main.gb_options.setposition . . . 155
	main.tx_crypto_symbol.show
	main.ed_crypto_symbol.show
	main.gb_options.show
	main.tx_crypto_market.show
	main.ed_crypto_market.show
	main.gb_crypto_time.show
	main.rb_crypto_daily.show
	main.rb_crypto_intraday.show
	main.rb_crypto_weekly.show
	main.rb_crypto_monthly.show
	main.tx_crypto_interval.show
	main.cb_crypto_interval.show
	main.ck_crypto_full.show
	main.ck_crypto_wide.show
	main.ck_crypto_clear.show
	program main_crypto_intraday_check
END

PROGRAM main_crypto_intraday_check
BEGIN

	if main.rb_crypto{
		call main.tx_crypto_interval.show
		call main.cb_crypto_interval.show
		if main.rb_crypto_intraday {
			call main.tx_crypto_interval.enable
			call main.cb_crypto_interval.enable
			call main.ck_crypto_full.enable
		}
		else {
			call main.tx_crypto_interval.disable
			call main.cb_crypto_interval.disable
			call main.ck_crypto_full.disable
		}
	}
END


SCRIPT main_show_commodity
BEGIN
	main.gb_options.setposition . . . 105
	main.tx_commodity.show
	main.cb_commodity.show
	main.gb_options.show
	main.gb_commodity_time.show
	main.rb_commodity_monthly.show
	main.rb_commodity_daily.show
	main.rb_commodity_weekly.show
	main.rb_commodity_quarterly.show
	main.rb_commodity_annual.show
	main.ck_commodity_clear.show
END

PROGRAM command
BEGIN
	if main.rb_set {
		put "aavantage set "
		require main.ed_key
		put main.ed_key
	}
	if main.rb_search {
		put "aavantage search "
		require main.ed_search
		put main.ed_search
	}

	if main.rb_list {
		put "aavantage list "
		require main.cb_list
		put main.cb_list
	}
	if main.rb_stock {
		put "aavantage stock "
		require main.ed_stock_symbol
		put main.ed_stock_symbol

		beginoptions
			optionarg main.cb_stock_interval
			if main.rb_stock_weekly {
				put "weekly"
			}
			if main.rb_stock_monthly {
				put "monthly"
			}
			option main.ck_stock_adjusted
			option main.ck_stock_full
			option main.ck_stock_wide
			option main.ck_stock_clear
		endoptions
	}
	if main.rb_index {
		put "aavantage index "
		require main.ed_index_symbol
		put main.ed_index_symbol

		beginoptions
			if main.rb_index_weekly {
				put "weekly"
			}
			if main.rb_index_monthly {
				put "monthly"
			}
			option main.ck_index_wide
			option main.ck_index_clear
		endoptions
	}

	if main.rb_crypto {
		put "aavantage crypto "
		require main.ed_crypto_symbol
		put main.ed_crypto_symbol

		beginoptions
		optionarg /hidedefault main.ed_crypto_market

		if main.rb_crypto_intraday {
			optionarg main.cb_crypto_interval
		}

		if main.rb_crypto_weekly {
			put "weekly"
		}

		if main.rb_crypto_monthly {
			put "monthly"
		}

		option main.ck_crypto_full
		option main.ck_crypto_wide
		option main.ck_crypto_clear
		endoptions
	}

	if main.rb_commodity {
		put "aavantage commodity "
		require main.cb_commodity
		put main.cb_commodity

		beginoptions
			if main.rb_commodity_daily {
				put "daily"
			}
			if main.rb_commodity_weekly {
				put "weekly"
			}
			if main.rb_commodity_quarterly {
				put "quarterly"
			}
			if main.rb_commodity_annual {
				put "annual"
			}
			option main.ck_commodity_clear
		endoptions
	}
END
